# 单人本地开发：根目录已提供 .env.development，默认走本机 server。
# 多人实时同步：不要使用各自的 localhost，请执行：
# npm run team:api -- http://共享后端电脑IP:3000
# 该命令会生成根目录 .env.local 和 admin-web/.env.local。
# 仅 H5 高德 Key 等私密项也放 .env.local（*.local 不进 Git）。

# 地图：模拟接口失败，验证 fallback 不白屏
# VITE_MAP_SIMULATE_API_ERROR=true

# 地图：走后端 /api/map/*（失败或空数据仍 fallback mock）
# VITE_MAP_USE_REMOTE_API=true

# 服务层：模拟接口失败
# VITE_SERVICE_SIMULATE_API_ERROR=true

# 服务层：走后端点评/反馈/问卷/工单等（需先启动 server：cd server && npm run dev）
# VITE_API_BASE_URL=http://localhost:3000
# VITE_SERVICE_USE_REMOTE_API=true

# 首页 / 发现：走后端公开 API（需 server 已写入 homeConfig / discoverPosts）
# VITE_HOME_USE_REMOTE_API=true
# VITE_DISCOVER_USE_REMOTE_API=true

# 商城：走后端 /api/mall/products（失败回退 mock；下架商品远程不可见）
# VITE_MALL_USE_REMOTE_API=true

# H5 地图：高德 JS API（仅 npm run dev:h5 / build:h5 使用，勿提交含 Key 的 .env.local）
# VITE_AMAP_KEY=你的Web端Key
# VITE_AMAP_SECURITY_JS_CODE=你的安全密钥
