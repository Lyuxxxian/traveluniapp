# 灵山文旅管理后台 — Nginx 示例（方案 A：同域静态 + API 反代）
# 复制到站点配置后修改 root、proxy_pass、server_name

server {
    listen 80;
    server_name admin.your-domain.com;

    # 管理端 SPA（admin-web/dist）
    root /var/www/traveluniapp-admin/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # 后端 API（traveluniapp/server，默认 3000）
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 10m;
    }

    # 上传文件静态访问（与 server /uploads 一致）
    location /uploads/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
    }
}

# 同域部署时 admin-web .env.production：
#   VITE_API_BASE_URL=
# 或：
#   VITE_API_BASE_URL=https://admin.your-domain.com
