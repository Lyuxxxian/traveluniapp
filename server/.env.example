# 复制为 .env 后按需修改（勿提交含真实密钥的 .env）

# 生产必设：强随机字符串
# JWT_SECRET=change-me-to-random-secret

# 生产必须为 production；生产环境禁止 ADMIN_AUTH_DISABLED
# NODE_ENV=production

# 仅本地调试可开启（生产会被拒绝启动）
# ADMIN_AUTH_DISABLED=true

# 服务端口
# PORT=3000

# 团队共享后端：监听所有网卡，队友可通过启动日志中的局域网地址访问
# HOST=0.0.0.0

# 和风天气（首页左上角，仅后端读取；控制台 https://console.qweather.com/）
# QWEATHER_API_KEY=你的Key
# QWEATHER_API_HOST=你的专属Host，如 xxx.qweatherapi.com（不要带 https://）
# QWEATHER_LNG=120.10
# QWEATHER_LAT=31.43
# QWEATHER_LOCATION=120.10,31.43
# QWEATHER_PLACE_NAME=灵山文旅景区
