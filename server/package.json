{
  "name": "traveluniapp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "verify": "node scripts/verify-service-api.mjs && node scripts/verify-admin-api.mjs && node scripts/verify-map-import.mjs",
    "verify:admin": "node scripts/verify-admin-api.mjs",
    "verify:mall": "node scripts/verify-mall-api.mjs",
    "verify:mall-admin": "node scripts/verify-mall-admin.mjs",
    "verify:mall-orders-admin": "node scripts/verify-mall-orders-admin.mjs",
    "verify:mall-all": "node scripts/verify-mall-api.mjs && node scripts/verify-mall-admin.mjs && node scripts/verify-mall-orders-admin.mjs",
    "verify:map": "node scripts/verify-map-api.mjs",
    "verify:map-admin": "node scripts/verify-map-admin.mjs",
    "verify:map-all": "node scripts/verify-map-api.mjs && node scripts/verify-map-admin.mjs && node scripts/verify-map-import.mjs",
    "verify:map-import": "node scripts/verify-map-import.mjs",
    "map:import": "node scripts/import-map-points.mjs",
    "map:import:dry": "node scripts/import-map-points.mjs --dry-run",
    "verify:p0": "node scripts/verify-p0-checklist.mjs",
    "admin:set-password": "node scripts/set-admin-password.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  }
}
